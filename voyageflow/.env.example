# Google API キー
GOOGLE_API_KEY=your_google_api_key_here

# Gemini モデル名
# ⚠️ 重要: 新SDK「google-genai」では、モデル名は以下のフルパス形式で指定してください
# 短形式（gemini-2.0-flash）は 404 Not Found になります
# 必ずフルパス形式「models/モデルID」で指定してください
MODEL_NAME=models/gemini-3.1-flash-lite-preview

# その他のモデル候補（いずれもフルパス形式）
# models/gemini-2.0-flash
# models/gemini-1.5-flash
# models/gemini-1.5-pro

# Google Cloud Service Account（オプション）
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# アプリケーション設定
STREAMLIT_CONFIG_THEME_BASE=light
DEBUG_MODE=False
